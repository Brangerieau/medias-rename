{
  "name": "medias-rename",
  "version": "1.0.0",
  "description": "Renommage de medias a partir de leurs metadonnees",
  "main": "src/main.js",
  "author": "Thibaud Brangerieau <contact@brangerieau-thibaud.fr>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.brangerieauthibaud.medias-rename",
    "productName": "Médias Rename",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Brangerieau",
      "repo": "medias-rename"
    },
    "asarUnpack": [
      "**/node_modules/exiftool-vendored.pl/**",
      "**/node_modules/exiftool-vendored.exe/**",
      "**/node_modules/libheif-js/**"
    ]
  },
  "dependencies": {
    "exiftool-vendored": "^37.2.0",
    "heic-convert": "^2.1.0"
  }
}
